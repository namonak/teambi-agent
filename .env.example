# .env.example — 실제 .env로 복사해 값을 채운다 (.env는 커밋 금지: .gitignore에 포함).
#   cp .env.example .env

# Agent 서버 포트
PORT=49877

# teamMoneyManager 주소.
# 같은 서버(같은 docker 네트워크)에 배포하면 http://localhost:49876 권장(지연 최소).
TMM_BASE_URL=

# teamMoneyManager 로그인 비밀번호 (봇이 세션 발급에 사용)
TMM_PASSWORD=

# Teams Outgoing Webhook 보안 토큰.
# Teams에서 웹훅 생성 시 "1회만" 표시되는 base64 문자열을 그대로 붙여넣는다.
# 미설정 시 /webhook은 모든 요청을 401로 거부한다(fail-closed).
TEAMS_WEBHOOK_SECRET=

# --- AI(자연어 처리·분류 폴백) 설정 -----------------------------------------
# 미설정이어도 카드 승인 문자 기입(정규식+키워드 분류)은 동작한다.

# 사용할 LLM 프로바이더: claude | gemini (기본 claude)
LLM_PROVIDER=claude

# [claude] API 키 — 발급: https://console.anthropic.com → API Keys (유료, 팀 사용량 기준 월 몇백 원)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5   # 기본값 (Teams 5초 응답 제한에 최적)

# [gemini] API 키 — 발급: https://aistudio.google.com/apikey (무료 티어 있음, 카드 등록 불필요)
# ⚠️ 무료 티어는 입력·출력이 Google 제품 개선(모델 학습)에 사용될 수 있다.
#    가맹점명·금액·팀원 이름이 전송되므로 회사 데이터 정책 확인 후 사용할 것.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash      # 기본값 (도구 호출 안정성 우선. 더 가볍게: gemini-3.5-flash-lite)
#                                    # ⚠️ gemini-2.5-flash는 신규 사용자에게 차단됐다(호출 시 404).
# GEMINI_REASONING_EFFORT=minimal    # 기본값(설정 불필요). thinking은 응답을 수 초 늘려 5초 예산을
#                                    # 넘기므로 최소로 낮춘다. Gemini 3 계열은 thinking을 끌 수 없고,
#                                    # 2.5 계열을 쓴다면 none으로 완전히 끌 수 있다.

# (선택·권장) Teams Workflows 웹후크 URL — 자연어 명령의 "즉시 접수 → 사후 게시" 모드용.
# 설정하면 자연어 요청에 "접수했어요"로 즉답하고, 실제 결과(최대 25초 처리)를 채널에 따로 게시한다.
# → 다건 등록이나 느린 AI 응답도 Teams 5초 제한 없이 처리 가능.
# 발급: Teams 채널 ⋯ → 워크플로 → "웹후크 요청이 수신되면 채널에 게시" 템플릿 → URL 복사
# (기존 O365 커넥터 방식 '수신 웹후크'는 2026-05 폐기 — 반드시 Workflows 앱으로)
# 미설정 시 기존처럼 5초 안에 동기 처리한다.
TEAMS_INCOMING_WEBHOOK_URL=

# 카드 문자 식별번호 → 앱 카드 슬롯(1|2) 매핑. 예: "3900:1,2903:2,0904:1"
# 매핑에 없는 번호는 카드 미지정(null)으로 기록되고 회신에 안내가 붙는다.
TEAMS_CARD_MAP=

# 시간대 (문자 날짜 해석·당월 판정 기준)
TZ=Asia/Seoul
