# .env.example — 실제 .env로 복사해 값을 채운다 (.env는 커밋 금지: .gitignore에 포함).
#   cp .env.example .env

# Agent 서버 포트
PORT=49877

# teamMoneyManager 주소.
# 같은 서버(같은 docker 네트워크)에 배포하면 http://localhost:49876 권장(지연 최소).
TMM_BASE_URL=

# teamMoneyManager 로그인 비밀번호 (봇이 세션 발급에 사용)
TMM_PASSWORD=

# Teams Bot 앱 등록 정보. Teams Developer Portal에서 발급받는다.
# MicrosoftAppId / MicrosoftAppPassword가 없으면 /api/messages는 503을 반환한다.
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=
# --- AI(자연어 처리·분류 폴백) 설정 -----------------------------------------
# 미설정이어도 카드 승인 문자 기입(정규식+키워드 분류)은 동작한다.

# 사용할 AI 제공자. 비우거나 gemini면 기존 Google Gemini 설정을 그대로 사용한다.
# OpenRouter로 바꾸려면 openrouter를 설정하고 아래 OPENROUTER_* 값을 채운다.
LLM_PROVIDER=gemini

# API 키 — 발급: https://aistudio.google.com/apikey (무료 티어 있음, 카드 등록 불필요)
# ⚠️ 무료 티어는 입력·출력이 Google 제품 개선(모델 학습)에 사용될 수 있다.
#    가맹점명·금액·팀원 이름이 전송되므로 회사 데이터 정책 확인 후 사용할 것.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_REASONING_EFFORT=minimal

# OpenRouter 설정 — LLM_PROVIDER=openrouter일 때만 사용.
# 키 발급: https://openrouter.ai/keys
# 모델명에는 제공자 접두사가 필요하다. 기본값은 google/gemini-3.5-flash-lite.
# OpenRouter는 요청을 여러 제공자에게 라우팅할 수 있으므로, 가맹점·금액·팀원 정보의
# 보존/학습 정책은 계정 설정과 사용할 모델의 provider 정책을 확인할 것.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# OPENROUTER_REASONING_EFFORT=minimal

# 카드 문자 식별번호 → 앱 카드 슬롯(1|2) 매핑. 예: "3900:1,2903:2,0904:1"
# 매핑에 없는 번호는 카드 미지정(null)으로 기록되고 회신에 안내가 붙는다.
TEAMS_CARD_MAP=

# 팀원 호칭(직책·별명) → 실제 이름 매핑. 형식: "이름=별칭1,별칭2;이름2=별칭3"
#   예: TEAMS_MEMBER_ALIASES=홍길동=홍실장,실장님;김철수=김팀장,팀장님
# teamMoneyManager 회원 정보에는 직책 필드가 없어서, "실장님 점심 12,000원"처럼
# 이름 없이 직책으로만 부르는 말을 해석하려면 여기에 적어야 한다.
# ("홍길동 실장님"처럼 이름이 함께 있으면 별칭 없이도 해석된다.)
# 미설정 시 봇은 추측해서 기입하지 않고 "누구인지 이름으로 말씀해 주세요"라고 되묻는다.
TEAMS_MEMBER_ALIASES=

# 시간대 (문자 날짜 해석·당월 판정 기준)
TZ=Asia/Seoul
